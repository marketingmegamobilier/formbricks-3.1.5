# Copia este archivo como .env (en la carpeta docker/) y completa los valores:
#   cp .env.example .env
# docker compose carga automaticamente las variables de aqui.

######################################## REQUERIDOS ########################################

# URL publica de tu instancia, ej: https://formularios.midominio.com
WEBAPP_URL=https://example.com

# Igual que WEBAPP_URL (dejar comentado para usar el mismo valor)
# NEXTAUTH_URL=https://example.com

# Genera uno con: openssl rand -hex 32
NEXTAUTH_SECRET=

# Genera uno con: openssl rand -hex 32
ENCRYPTION_KEY=

# Genera uno con: openssl rand -hex 32
CRON_SECRET=

############################### BASE DE DATOS (opcional) ###############################

# Password del postgres incluido (default: postgres)
# POSTGRES_PASSWORD=postgres

# Cadena de conexion externa (si usas tu propio postgres, descomenta y ajusta)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/formbricks?schema=public

#################################### EMAIL (opcional) ####################################

# MAIL_FROM="Formularios <no-reply@midominio.com>"
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATED=1
# SMTP_SECURE_ENABLED=1

################################## APLICACION (opcional) #################################

# PRIVACY_URL=
# TERMS_URL=
# IMPRINT_URL=
# UNSPLASH_ACCESS_KEY=
