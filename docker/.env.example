# Copia este archivo como .env (en la carpeta docker/) y completa los valores:
#   cp .env.example .env
# Regla de oro: las variables comentadas NO existen para el contenedor.
# Descomenta SOLO las que uses y con valor real — un valor vacio revienta la
# validacion de entorno de la app.

######################################## REQUERIDOS ########################################

# URL publica de tu instancia, ej: https://formularios.midominio.com
WEBAPP_URL=https://example.com

# Igual que WEBAPP_URL (comentar para heredar el mismo valor)
# NEXTAUTH_URL=https://example.com

# Genera uno con: openssl rand -hex 32
NEXTAUTH_SECRET=

# Genera uno con: openssl rand -hex 32
ENCRYPTION_KEY=

# Genera uno con: openssl rand -hex 32
CRON_SECRET=

############################### BASE DE DATOS (opcional) ###############################

# Password del postgres incluido (default: postgres)
# POSTGRES_PASSWORD=postgres

# Cadena de conexion externa (si usas tu propio postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/formbricks?schema=public

#################################### EMAIL (opcional) ####################################

# MAIL_FROM="Formularios <no-reply@midominio.com>"
# SMTP_HOST=smtp.midominio.com
# SMTP_PORT=587
# SMTP_USER=no-reply@midominio.com
# SMTP_PASSWORD=
# SMTP_AUTHENTICATED=1
# SMTP_SECURE_ENABLED=1          # solo para TLS puerto 465
# SMTP_REJECT_UNAUTHORIZED_TLS=1 # 0 para aceptar TLS con CA propia

################################## APLICACION (opcional) #################################

# PRIVACY_URL=https://midominio.com/privacidad
# TERMS_URL=https://midominio.com/terminos
# IMPRINT_URL=https://midominio.com/aviso-legal
# IMPRINT_ADDRESS=Calle Falsa 123, Ciudad
# SHORT_URL_BASE=https://sho.rt
# UNSPLASH_ACCESS_KEY=
# UPLOADS_DIR=/ruta/custom/uploads

############################### FLAGS 1|0 (opcional) ####################################

# EMAIL_VERIFICATION_DISABLED=1  # 0 requiere configuracion de email
# PASSWORD_RESET_DISABLED=1      # 0 requiere configuracion de email
# EMAIL_AUTH_DISABLED=1
# INVITE_DISABLED=1
# RATE_LIMITING_DISABLED=1
# ENTERPRISE_LICENSE_KEY=

#################################### S3 (opcional) #######################################

# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=               # para S3-compatible (StorJ, MinIO...)
# S3_FORCE_PATH_STYLE=1

#################################### OAUTH (opcional) ####################################

# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZUREAD_CLIENT_ID=
# AZUREAD_CLIENT_SECRET=
# AZUREAD_TENANT_ID=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# OIDC_DISPLAY_NAME=
# OIDC_SIGNING_ALGORITHM=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

############################## INTEGRACIONES (opcional) ##################################

# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# GOOGLE_SHEETS_CLIENT_ID=
# GOOGLE_SHEETS_CLIENT_SECRET=
# GOOGLE_SHEETS_REDIRECT_URL=
# AIRTABLE_CLIENT_CLIENT_ID=
